    {
      "parameters": {
        "jsCode": "const alerts = items.map(i => i.json);\n\nconst buckets = {};\n\nalerts.forEach(alert => {\n\n  const time = new Date(alert.timestamp);\n\n  // group per minute\n  const bucket =\n    time.getFullYear() + \"-\" +\n    String(time.getMonth()+1).padStart(2,'0') + \"-\" +\n    String(time.getDate()).padStart(2,'0') + \" \" +\n    String(time.getHours()).padStart(2,'0') + \":\" +\n    String(time.getMinutes()).padStart(2,'0');\n\n  if (!buckets[bucket]) {\n    buckets[bucket] = {\n      timestamp: bucket,\n      open: 0,\n      investigating: 0,\n      contained: 0,\n      closed: 0,\n      escalated: 0,\n      false_positive: 0\n    };\n  }\n\n  const status = alert.status?.toLowerCase();\n\n  if (buckets[bucket][status] !== undefined) {\n    buckets[bucket][status]++;\n  }\n\n});\n\nreturn Object.values(buckets).map(b => ({ json: b }));"
      },
