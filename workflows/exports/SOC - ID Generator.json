    {
      "parameters": {
        "jsCode": "// Get the current item (from Get row(s) on first run, \n// or from the loop — but we need retry_count from previous context)\n// n8n passes all input items; check for retry_count in any of them\n\nconst tableRow = $input.all().find(i => i.json.current_value !== undefined);\nconst retryItem = $input.all().find(i => i.json.retry_count !== undefined);\n\nconst current = tableRow?.json?.current_value || 0;\nconst retry_count = (retryItem?.json?.retry_count || 0) + 1;\nconst next = current + 1;\n\nreturn [\n  {\n    json: {\n      current_value: current,\n      next_value: next,\n      soc_id: \"SOC-\" + String(next).padStart(4, \"0\"),\n      retry_count\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
