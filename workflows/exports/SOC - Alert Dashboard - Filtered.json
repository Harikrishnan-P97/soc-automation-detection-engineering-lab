    {
      "parameters": {
        "jsCode": "return items.map(item => {\n\n  const status = item.json.status;\n  let actions;\n\n  if (status === \"open\") {\n    actions = \"Investigate | Escalate | Close | False Positive\";\n  } \n  else if (status === \"investigating\") {\n    actions = \"Escalate | Close | False Positive\";\n  }\n    else if (status === \"contained\") {\n  actions = \"Unisolate\";\n  }\n  else if (status === \"escalated\") {\n    actions = \"Escalated\";\n  }\n  else if (status === \"closed\") {\n    actions = \"Resolved\";\n  }\n  else if (status === \"false_positive\") {\n    actions = \"False Positive\";\n  }\n\n  item.json.actions = actions;\n\n  return item;\n});"
      },
